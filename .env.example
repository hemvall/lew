# Supabase: use Connect > Session pooler. Keep this file's real values out of Git.
DATABASE_URL=postgresql://postgres.cxnjjgwiizummimxytsx:PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres
# Optional Supabase CA certificate downloaded from the dashboard; TLS is verified.
# SUPABASE_CA_FILE=/path/to/prod-supabase.cer
# Codex must be installed and its home directory persisted on the worker.
# LEW_CODEX_BIN=codex
LEW_DATA_DIR=.lew
PORT=3000
LEW_HOST=127.0.0.1
# Required when listening remotely. Use a long random value and HTTPS.
# LEW_ACCESS_TOKEN=
# Optional GitHub read token. Git push/clone uses the worker's Git credential helper.
# GITHUB_TOKEN=
